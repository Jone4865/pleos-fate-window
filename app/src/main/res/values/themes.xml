<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FateWindow" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/fw_gold</item>
        <item name="colorPrimaryVariant">#E0B43D</item>
        <item name="colorOnPrimary">@color/fw_bg</item>
        <item name="colorSecondary">@color/fw_cyan</item>
        <item name="colorOnSurface">@color/fw_text</item>
        <item name="android:windowBackground">@color/fw_bg</item>
        <item name="android:statusBarColor">@color/fw_bg</item>
    </style>

    <!-- 아래 FateWindow.* 위젯 스타일들의 루트 -->
    <style name="FateWindow" />

    <style name="FateWindow.Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fw_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FateWindow.Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/pill</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FateWindow.Switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:textColor">@color/fw_text_dim</item>
        <item name="android:textSize">24sp</item>
        <item name="android:switchPadding">20dp</item>
        <item name="android:scaleX">1.0</item>
    </style>

    <style name="FateWindow.Button.Primary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">112dp</item>
        <item name="android:minWidth">340dp</item>
        <item name="android:paddingStart">48dp</item>
        <item name="android:paddingEnd">48dp</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/fw_gold</item>
        <item name="android:textColor">@color/fw_bg</item>
        <item name="cornerRadius">56dp</item>
    </style>

    <style name="FateWindow.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">112dp</item>
        <item name="android:minWidth">240dp</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/fw_gold</item>
        <item name="strokeColor">@color/fw_gold</item>
        <item name="strokeWidth">3dp</item>
        <item name="cornerRadius">56dp</item>
    </style>
</resources>
