<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0B0B14">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFD34D"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="참가자 착좌 감지됨"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Spinner
        android:id="@+id/modeSpinner"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/windowSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="창문 연출 사용(비·밤엔 자동 OFF)"
        android:textColor="#CFCFE0" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/excludeDriverSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="운전자 제외"
        android:textColor="#CFCFE0" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="▶  룰렛 시작"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/resultText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#9BE7FF"
        android:textSize="22sp" />
</LinearLayout>
